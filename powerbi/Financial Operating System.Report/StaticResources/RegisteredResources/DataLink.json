{
  "name": "DataLink",
  "dataColors": [
    "#2a78d6",
    "#eb6834",
    "#1baf7a",
    "#eda100",
    "#e87ba4",
    "#008300",
    "#4a3aa7",
    "#e34948"
  ],
  "good": "#0ca30c",
  "neutral": "#fab219",
  "bad": "#d03b3b",
  "minimum": "#2a78d6",
  "center": "#8a8a85",
  "maximum": "#d03b3b",
  "null": "#6b6b6b",
  "foreground": "#0b0b0b",
  "foregroundNeutralSecondary": "#52514e",
  "foregroundNeutralTertiary": "#8a8a85",
  "background": "#fcfcfb",
  "backgroundLight": "#f2f2f0",
  "backgroundNeutral": "#e6e6e3",
  "tableAccent": "#2a78d6",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 14,
      "color": "#0b0b0b"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#0b0b0b"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#52514e"
    },
    "callout": {
      "fontFace": "Segoe UI Light",
      "fontSize": 36,
      "color": "#0b0b0b"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "_comment": "Grid and axes are RECESSIVE. The data is the figure; the chrome is the ground.",
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#fcfcfb"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0b0b0b"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#52514e"
              }
            },
            "fontSize": 10,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#52514e"
              }
            },
            "fontSize": 10,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#e6e6e3"
              }
            },
            "gridlineThickness": 1,
            "gridlineStyle": "solid"
          }
        ],
        "labels": [
          {
            "_comment": "On by default because three categorical slots fall below 3:1 on this surface and the relief rule requires visible labels. Turn them off only on a visual that already ships a table view.",
            "show": true,
            "color": {
              "solid": {
                "color": "#0b0b0b"
              }
            },
            "fontSize": 9
          }
        ],
        "legend": [
          {
            "_comment": "A legend is always present for two or more series - identity is never carried by colour alone.",
            "show": true,
            "position": "Top",
            "showTitle": false,
            "labelColor": {
              "solid": {
                "color": "#52514e"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#0b0b0b"
              }
            },
            "fontSize": 32,
            "fontFamily": "Segoe UI Light"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#52514e"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVerticalWeight": 0,
            "gridHorizontalWeight": 1,
            "gridHorizontalColor": {
              "solid": {
                "color": "#e6e6e3"
              }
            },
            "outlineWeight": 0
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#0b0b0b"
              }
            },
            "backColor": {
              "solid": {
                "color": "#f2f2f0"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "matrix": {
      "*": {
        "grid": [
          {
            "gridVerticalWeight": 0,
            "gridHorizontalWeight": 1,
            "gridHorizontalColor": {
              "solid": {
                "color": "#e6e6e3"
              }
            },
            "outlineWeight": 0
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#0b0b0b"
              }
            },
            "backColor": {
              "solid": {
                "color": "#f2f2f0"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2,
            "showMarker": true,
            "markerSize": 4
          }
        ],
        "labels": [
          {
            "show": false,
            "_comment": "Never a number on every point. Direct-label the last point or the extremes only."
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#52514e"
              }
            },
            "fontSize": 10
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#0b0b0b"
              }
            },
            "fontSize": 10
          }
        ]
      }
    }
  }
}